# NOTE: pubspec.lock SENGAJA di-track (ini APP, bukan package)
# agar build reproducible di semua mesin/CI.

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android — native shell di-track; yang di-ignore hanya generated/lokal.
# JANGAN blanket-ignore /android/ (clone baru tak bisa build).
/android/.gradle/
/android/.kotlin/
/android/local.properties
/android/key.properties
*.jks
/android/app/debug
/android/app/profile
/android/app/release
**/android/captures/
/android/.idea

# iOS — native shell di-track; yang di-ignore hanya generated/lokal.
# JANGAN blanket-ignore /ios/ (clone baru tak bisa build).
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/.sentry-native/
**/ios/**/Flutter/App.framework
**/ios/**/Flutter/Flutter.framework
**/ios/**/Flutter/Flutter.podspec
**/ios/**/Flutter/Generated.xcconfig
**/ios/**/Flutter/app.flx
**/ios/**/Flutter/app.zip
**/ios/**/Flutter/flutter_assets/
**/ios/**/Flutter/flutter_export_environment.sh
**/ios/**/Flutter/ephemeral/
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*
# Xcode SPM cache (Package.resolved tetap di-track bila ada)
**/xcshareddata/swiftpm/*
!**/xcshareddata/swiftpm/Package.resolved
**/ios/.symlinks/
ios/Pods/
ios/.idea

# Platform lain (tidak dipakai proyek ini)
